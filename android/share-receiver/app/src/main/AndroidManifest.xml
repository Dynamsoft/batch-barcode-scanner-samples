<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_bbs_data_receiver"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_bbs_data_receiver"
        android:supportsRtl="true"
        android:theme="@style/Theme.BBSDataReceiver">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait"
            android:exported="true">

            <!-- Standard launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                ============================================================
                SHARE RECEPTION: Register for ACTION_SEND_MULTIPLE
                ============================================================
                This intent-filter allows this app to appear in the Android
                share sheet when another app shares multiple files at once.
                We use mimeType="*/*" to accept any file combination
                (images + CSV) sent together in one share action.
                ============================================================
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>