<?xml version="1.0" encoding="utf-8"?>
<!-- Track colour for the "Hide Marks" switch: orange when ON, light grey when OFF. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/switch_track_on" android:state_checked="true" />
    <item android:color="@color/switch_track_off" android:state_checked="false" />
</selector>
